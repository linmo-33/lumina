# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=please-change-me-to-a-long-random-string

# 后台供应商密钥的加密主密钥（建议配置至少 32 位随机字符串）
# 未配置时会兼容使用 BETTER_AUTH_SECRET 派生加密密钥
LUMINA_CONFIG_ENCRYPTION_KEY=please-change-me-to-another-long-random-string

# Resend 邮箱验证码（发件域名需先在 Resend 中验证）
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Lumina <noreply@example.com>

