# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=please-change-me-to-a-long-random-string

# Resend 邮箱验证码（发件域名需先在 Resend 中验证）
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Lumina <noreply@example.com>

# chatgpt2api 配置
CHATGPT2API_BASE_URL=http://localhost:3000/v1
CHATGPT2API_KEY=your-auth-key

# 每日灵点补给的重置时区（Docker 镜像默认 Asia/Shanghai）
TZ=Asia/Shanghai
